{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "auditra-api",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "backend/manage.py",
        "runserver",
        "0.0.0.0:8000"
      ],
      "port": 8000
    },
    {
      "name": "auditra-console",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--host",
        "0.0.0.0"
      ],
      "port": 5173
    }
  ]
}